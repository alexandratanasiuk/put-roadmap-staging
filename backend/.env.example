# Копируйте в .env и заполните. Не коммитьте .env.

# Сервер
PORT=3011
HOST=127.0.0.1

# JWT (обязательно для /api/login)
JWT_SECRET=замените_на_длинную_случайную_строку

# База: postgres
DB_DIALECT=postgres
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Опционально: SSL к облачной БД
# DB_SSL=true

# Первый админ (создаётся только если пользователя ещё нет)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=задайте_надёжный_пароль

# Гость: логин/пароль и чьи этапы видны (только просмотр, без POST/PUT/DELETE блоков)
# GUEST_USERNAME=Гость
# GUEST_PASSWORD=1
# GUEST_VIEW_OWNER=ProjectArchitect

# Владелец этапов и делегат (project_user)
PROJECT_ARCHITECT_USERNAME=ProjectArchitect
PROJECT_USER_USERNAME=ProjectUser
PROJECT_USER_PASSWORD=user01

# CORS: через запятую, дополнительно к стандартным localhost-портам
# CORS_ORIGINS=http://localhost:3010
# Для внешнего staging без reverse proxy:
# CORS_ORIGINS=http://put-roadmap-staging.duckdns.org:3002

# Вкладка «Пользователи» (тест): GET /api/users/test-directory. По умолчанию включено при NODE_ENV != production.
# ENABLE_TEST_USER_DIRECTORY=true

# --- ИИ-ассистент в продукте (чат; секреты только на сервере, не коммитьте .env) ---
# ASSISTANT_ENABLED=false

# Провайдер: gigachat | openai | …
# LLM_PROVIDER=gigachat

# Для OpenAI / совместимых API:
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# --- GigaChat (Сбер): ключ авторизации = строка для Authorization: Basic … ---
# Получение: https://developers.sber.ru/docs/ru/gigachat/quickstart
# GIGACHAT_AUTHORIZATION_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# Проверка TLS: false — только если нет цепочки до НУЦ (ошибка сертификата у Node).
# GIGACHAT_VERIFY_SSL=true

# Максимум токенов в ответе (completion)
# LLM_MAX_COMPLETION_TOKENS=2048

# Максимум токенов во входном контексте (опционально)
# LLM_MAX_PROMPT_TOKENS=32000

# Таймаут HTTP к LLM (мс)
# LLM_TIMEOUT_MS=120000
