# Скопируйте в .env в этой папке (frontend/). Vite подхватывает только префикс VITE_.

# При необходимости (если API не на том же origin):
# VITE_API_BASE_URL=/api

# Режим заглушки техработ в main:
# true  - показать экран "Ведутся технические работы"
# false - открыть приложение в обычном режиме
VITE_TECHNICAL_WORKS_MODE=true
